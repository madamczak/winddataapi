# Copy to .env and fill in your values (never commit .env to git)

# ── API data path ─────────────────────────────────────────────────────────────
# Folder containing the SQLite .db files (data_by_turbine/)
# In Docker this is the path inside the container (mounted volume)
DATA_DIR=/data

# Grafana Cloud — Loki (logs)
GRAFANA_LOKI_INSTANCE_ID=1380423
GRAFANA_LOKI_URL=https://logs-prod-025.grafana.net/loki/api/v1/push

# Grafana Cloud — Mimir (metrics)
GRAFANA_METRICS_INSTANCE_ID=1422629
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-north-0.grafana.net/otlp

# Shared token (needs logs:write + metrics:write scopes)
GRAFANA_TOKEN=glc_your_token_here

