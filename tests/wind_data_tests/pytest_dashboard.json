{
  "dashboard": {
    "id": null,
    "title": "Pytest Test Results",
    "tags": ["pytest", "testing", "automation"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Total Tests",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "sum(count_over_time({app=\"wind_data_tests\", env=\"test\"} |= \"SESSION\" [1h]))",
            "legendFormat": "Total Sessions"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "thresholds"
            }
          }
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Passed Tests",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "sum(count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"info\"} |= \"TEST PASSED\" [1h]))",
            "legendFormat": "Passed"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "fixed",
              "fixedColor": "green"
            }
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Failed Tests",
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "sum(count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"error\"} |= \"TEST FAILED\" [1h]))",
            "legendFormat": "Failed"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "fixed",
              "fixedColor": "red"
            }
          }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Skipped Tests",
        "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "sum(count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"warning\"} |= \"TEST SKIPPED\" [1h]))",
            "legendFormat": "Skipped"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "fixed",
              "fixedColor": "orange"
            }
          }
        }
      },
      {
        "id": 5,
        "type": "gauge",
        "title": "Pass Rate",
        "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "sum(count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"info\"} |= \"TEST PASSED\" [1h])) / sum(count_over_time({app=\"wind_data_tests\", env=\"test\"} |= \"TEST (PASSED|FAILED|SKIPPED)\" [1h])) * 100",
            "legendFormat": "Pass Rate"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 50},
                {"color": "yellow", "value": 70},
                {"color": "green", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "type": "bargauge",
        "title": "Test Results Summary",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"info\"} |= \"TEST PASSED\" [1h])",
            "legendFormat": "Passed"
          },
          {
            "refId": "B",
            "expr": "count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"error\"} |= \"TEST FAILED\" [1h])",
            "legendFormat": "Failed"
          },
          {
            "refId": "C",
            "expr": "count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"warning\"} |= \"TEST SKIPPED\" [1h])",
            "legendFormat": "Skipped"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {}
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Passed"},
              "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byName", "options": "Failed"},
              "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byName", "options": "Skipped"},
              "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
            }
          ]
        }
      },
      {
        "id": 7,
        "type": "piechart",
        "title": "Test Results Distribution",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 6},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"info\"} |= \"TEST PASSED\" [1h])",
            "legendFormat": "Passed"
          },
          {
            "refId": "B",
            "expr": "count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"error\"} |= \"TEST FAILED\" [1h])",
            "legendFormat": "Failed"
          },
          {
            "refId": "C",
            "expr": "count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"warning\"} |= \"TEST SKIPPED\" [1h])",
            "legendFormat": "Skipped"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "pieType": "pie"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {}
          }
        }
      },
      {
        "id": 8,
        "type": "table",
        "title": "Test Results Over Time",
        "gridPos": {"x": 0, "y": 10, "w": 24, "h": 8},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "{app=\"wind_data_tests\", env=\"test\"} |= \"TEST (PASSED|FAILED|SKIPPED)\"",
            "legendFormat": "Test Results"
          }
        ],
        "options": {
          "showHeader": true
        },
        "fieldConfig": {
          "defaults": {
            "custom": {}
          }
        }
      },
      {
        "id": 9,
        "type": "timeseries",
        "title": "Test Duration Trend",
        "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "sum by(level) (count_over_time({app=\"wind_data_tests\", env=\"test\"} |= \"TEST (PASSED|FAILED|SKIPPED)\" [5m]))",
            "legendFormat": "{{level}}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "id": 10,
        "type": "stat",
        "title": "Session Status",
        "gridPos": {"x": 12, "y": 18, "w": 12, "h": 6},
        "datasource": "Loki",
        "targets": [
          {
            "refId": "A",
            "expr": "count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"info\"} |= \"SESSION PASSED\" [1h])",
            "legendFormat": "Sessions Passed"
          },
          {
            "refId": "B",
            "expr": "count_over_time({app=\"wind_data_tests\", env=\"test\", level=\"error\"} |= \"SESSION FAILED\" [1h])",
            "legendFormat": "Sessions Failed"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "custom",
          "label": "Environment",
          "query": "test,dev,staging,prod",
          "current": {"selected": false, "text": "test", "value": "test"},
          "hide": 0
        },
        {
          "name": "time_range",
          "type": "textbox",
          "label": "Time Range",
          "query": "1h,6h,12h,24h,7d",
          "current": {"selected": false, "text": "1h", "value": "1h"},
          "hide": 0
        }
      ]
    }
  }
}