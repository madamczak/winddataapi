{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki data source receiving apicrawler logs (app=apicrawler)",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana",   "id": "grafana",      "name": "Grafana",      "version": "10.0.0" },
    { "type": "datasource","id": "loki",          "name": "Loki",         "version": "1.0.0" },
    { "type": "panel",     "id": "stat",          "name": "Stat",         "version": "" },
    { "type": "panel",     "id": "timeseries",    "name": "Time series",  "version": "" },
    { "type": "panel",     "id": "logs",          "name": "Logs",         "version": "" }
  ],

  "title": "API Crawler — Basic Monitor",
  "uid": "apicrawler-basic-v1",
  "description": "Simple starting dashboard for the apicrawler (crawl.py). Loki labels: app=apicrawler, farm, pattern, pi, level.",
  "tags": ["apicrawler", "windcrawler"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],

  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "loki",
        "label": "Loki data source",
        "hide": 0,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "farm",
        "type": "query",
        "label": "Farm",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": {
          "type": 1,
          "label": "farm",
          "stream": "{app=\"apicrawler\"}"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {}
      },
      {
        "name": "pattern",
        "type": "query",
        "label": "Pattern",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": {
          "type": 1,
          "label": "pattern",
          "stream": "{app=\"apicrawler\"}"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {}
      },
      {
        "name": "pi",
        "type": "query",
        "label": "Pi / runner",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": {
          "type": 1,
          "label": "pi",
          "stream": "{app=\"apicrawler\"}"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {}
      }
    ]
  },

  "panels": [

    {
      "type": "row",
      "id": 10,
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 1,
      "title": "Matches found",
      "description": "Log lines containing '🎯 MATCH' — each represents a valid hour where ≥70% of turbines satisfied the pattern.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",  "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "displayName": "Matches"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "count_over_time(\n  {app=\"apicrawler\", farm=~\"$farm\", pattern=~\"$pattern\", pi=~\"$pi\"}\n  |= \"MATCH #\"\n  [$__range]\n)",
          "legendFormat": "Matches",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Samples checked",
      "description": "Log lines matching the per-iteration progress marker '[N/M]'. Each line = one (date, hour) slot evaluated.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "displayName": "Samples"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "count_over_time(\n  {app=\"apicrawler\", farm=~\"$farm\", pattern=~\"$pattern\", pi=~\"$pi\", level=\"info\"}\n  |~ \"\\\\[\\\\s*[0-9]+/\"\n  [$__range]\n)",
          "legendFormat": "Slots checked",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "API request warnings",
      "description": "Loki lines where level=warning — typically 'Request failed (attempt N/3)' or API errors for individual turbines.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red",    "value": 20 }
            ]
          },
          "displayName": "Warnings"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "count_over_time(\n  {app=\"apicrawler\", farm=~\"$farm\", pattern=~\"$pattern\", pi=~\"$pi\", level=\"warning\"}\n  [$__range]\n)",
          "legendFormat": "Warnings",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Errors",
      "description": "Loki lines where level=error — e.g. could not fetch farm metadata, unknown pattern, all retries exhausted.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          },
          "displayName": "Errors"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "count_over_time(\n  {app=\"apicrawler\", farm=~\"$farm\", pattern=~\"$pattern\", pi=~\"$pi\", level=\"error\"}\n  [$__range]\n)",
          "legendFormat": "Errors",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },

    {
      "type": "row",
      "id": 11,
      "title": "Activity over time",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 5,
      "title": "Log volume — info / warning / error",
      "description": "Count of log lines per level over time. Spikes in 'warning' indicate API retries; 'error' lines warrant investigation.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["sum"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 0,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [ { "id": "color", "value": { "fixedColor": "#73bf69", "mode": "fixed" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "warning" },
            "properties": [ { "id": "color", "value": { "fixedColor": "#f5a623", "mode": "fixed" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [ { "id": "color", "value": { "fixedColor": "#e05252", "mode": "fixed" } } ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (level) (\n  count_over_time(\n    {app=\"apicrawler\", farm=~\"$farm\", pattern=~\"$pattern\", pi=~\"$pi\"}\n    [$__interval]\n  )\n)",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "type": "row",
      "id": 12,
      "title": "Matches",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },

    {
      "id": 6,
      "title": "Matches per farm & pattern",
      "description": "Matches over time broken out by farm and pattern labels.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 70,
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (farm, pattern) (\n  count_over_time(\n    {app=\"apicrawler\", farm=~\"$farm\", pattern=~\"$pattern\", pi=~\"$pi\"}\n    |= \"MATCH #\"\n    [$__interval]\n  )\n)",
          "legendFormat": "{{farm}} / {{pattern}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Warnings per farm & pattern",
      "description": "API request warnings over time — useful for spotting when a specific farm/pattern is consistently failing.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 70,
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (farm, pattern) (\n  count_over_time(\n    {app=\"apicrawler\", farm=~\"$farm\", pattern=~\"$pattern\", pi=~\"$pi\", level=\"warning\"}\n    [$__interval]\n  )\n)",
          "legendFormat": "{{farm}} / {{pattern}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "type": "row",
      "id": 13,
      "title": "Raw log lines",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },

    {
      "id": 8,
      "title": "Live log stream",
      "description": "All apicrawler log lines matching the selected farm / pattern / pi filters. Most recent first.",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "{app=\"apicrawler\", farm=~\"$farm\", pattern=~\"$pattern\", pi=~\"$pi\"}",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }

  ]
}

